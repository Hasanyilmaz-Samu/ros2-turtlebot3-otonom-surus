<?xml version="1.0"?>
<!--
  SENARYO 3 - EV PLANI (8x8)
  Baslangic: Salon (-3.0, -3.0), yaw = 90 derece  |  Hedef: Yatak Odasi 2 (3.2, 3.2)
  Baslangic/hedef konumlari config/scenarios.yaml dosyasinda tanimlidir.

  Kat plani (ust = +y / kuzey). Ic duvarlar 0.1 m kalinlik, kapilar 1.0 m genislik.

   y=4  +=================+================+===============+
        |                 |                |               |
        |  YATAK ODASI 1  |     BANYO      | YATAK ODASI 2 |
        |  [yatak]        |   [kuvet]      | [yatak]   (H) |
        |                 |                |               |
   y=0.4+===  ===============  ================  ===  =====+
        |   K1                K4                 K5        |
        |                    KORIDOR                       |
  y=-0.8+=====  ================================  =========+
        |       K2       |                       K3        |
        |                |                                 |
        |    SALON       K6        MUTFAK                  |
        |   [sehpa]      |        [masa]                   |
        | (S)  [koltuk]  |   [ tezgah      ]               |
   y=-4 +================+=================================+
       x=-4            x=-0.5                             x=4
-->
<sdf version="1.6">
  <world name="senaryo3_ev">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -7 9.5 0 0.93 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <include><uri>model://arena_walls</uri></include>

    <!-- ===================== IC DUVARLAR ===================== -->
    <model name="ev_duvarlari">
      <static>true</static>
      <link name="link">

        <!-- Duvar A (y = -0.8): Salon/Mutfak - Koridor -->
        <collision name="a1_c"><pose>-3.46 -0.8 0.25 0 0 0</pose><geometry><box><size>0.93 0.1 0.5</size></box></geometry></collision>
        <visual name="a1_v"><pose>-3.46 -0.8 0.25 0 0 0</pose><geometry><box><size>0.93 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <collision name="a2_c"><pose>0.0 -0.8 0.25 0 0 0</pose><geometry><box><size>4.0 0.1 0.5</size></box></geometry></collision>
        <visual name="a2_v"><pose>0.0 -0.8 0.25 0 0 0</pose><geometry><box><size>4.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <collision name="a3_c"><pose>3.46 -0.8 0.25 0 0 0</pose><geometry><box><size>0.93 0.1 0.5</size></box></geometry></collision>
        <visual name="a3_v"><pose>3.46 -0.8 0.25 0 0 0</pose><geometry><box><size>0.93 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <!-- Duvar B (y = 0.4): Koridor - Yatak1/Banyo/Yatak2 -->
        <collision name="b1_c"><pose>-3.56 0.4 0.25 0 0 0</pose><geometry><box><size>0.73 0.1 0.5</size></box></geometry></collision>
        <visual name="b1_v"><pose>-3.56 0.4 0.25 0 0 0</pose><geometry><box><size>0.73 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <collision name="b2_c"><pose>-1.35 0.4 0.25 0 0 0</pose><geometry><box><size>1.7 0.1 0.5</size></box></geometry></collision>
        <visual name="b2_v"><pose>-1.35 0.4 0.25 0 0 0</pose><geometry><box><size>1.7 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <collision name="b3_c"><pose>1.35 0.4 0.25 0 0 0</pose><geometry><box><size>1.7 0.1 0.5</size></box></geometry></collision>
        <visual name="b3_v"><pose>1.35 0.4 0.25 0 0 0</pose><geometry><box><size>1.7 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <collision name="b4_c"><pose>3.56 0.4 0.25 0 0 0</pose><geometry><box><size>0.73 0.1 0.5</size></box></geometry></collision>
        <visual name="b4_v"><pose>3.56 0.4 0.25 0 0 0</pose><geometry><box><size>0.73 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <!-- Duvar C (x = -0.5): Salon - Mutfak (Kapi K6) -->
        <collision name="c1_c"><pose>-0.5 -3.26 0.25 0 0 0</pose><geometry><box><size>0.1 1.33 0.5</size></box></geometry></collision>
        <visual name="c1_v"><pose>-0.5 -3.26 0.25 0 0 0</pose><geometry><box><size>0.1 1.33 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <collision name="c2_c"><pose>-0.5 -1.2 0.25 0 0 0</pose><geometry><box><size>0.1 0.8 0.5</size></box></geometry></collision>
        <visual name="c2_v"><pose>-0.5 -1.2 0.25 0 0 0</pose><geometry><box><size>0.1 0.8 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <!-- Duvar D (x = -1.2): Yatak Odasi 1 - Banyo -->
        <collision name="d_c"><pose>-1.2 2.16 0.25 0 0 0</pose><geometry><box><size>0.1 3.52 0.5</size></box></geometry></collision>
        <visual name="d_v"><pose>-1.2 2.16 0.25 0 0 0</pose><geometry><box><size>0.1 3.52 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

        <!-- Duvar E (x = 1.2): Banyo - Yatak Odasi 2 -->
        <collision name="e_c"><pose>1.2 2.16 0.25 0 0 0</pose><geometry><box><size>0.1 3.52 0.5</size></box></geometry></collision>
        <visual name="e_v"><pose>1.2 2.16 0.25 0 0 0</pose><geometry><box><size>0.1 3.52 0.5</size></box></geometry>
          <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>

      </link>
    </model>

    <!-- ===================== MOBILYALAR (statik engeller) ===================== -->

    <!-- Salon -->
    <model name="salon_koltuk">
      <static>true</static>
      <pose>-1.6 -3.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.5 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.5 1</ambient><diffuse>0.3 0.3 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="salon_sehpa">
      <static>true</static>
      <pose>-2.2 -2.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.4</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Mutfak -->
    <model name="mutfak_tezgah">
      <static>true</static>
      <pose>2.0 -3.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.4 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.4 0.5 0.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="mutfak_masa">
      <static>true</static>
      <pose>1.6 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Yatak Odasi 1 -->
    <model name="yatak_1">
      <static>true</static>
      <pose>-3.2 2.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.1 1.6 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.1 1.6 0.4</size></box></geometry>
          <material><ambient>0.7 0.5 0.6 1</ambient><diffuse>0.7 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Banyo -->
    <model name="banyo_kuvet">
      <static>true</static>
      <pose>0.0 3.4 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.6 0.45</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 0.45</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Yatak Odasi 2 (hedef odasi) -->
    <model name="yatak_2">
      <static>true</static>
      <pose>3.3 2.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.1 1.6 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.1 1.6 0.4</size></box></geometry>
          <material><ambient>0.7 0.5 0.6 1</ambient><diffuse>0.7 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
